# Telemetry Tracker settings. Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is git-ignored, so your key never gets committed.

# ---- LLM (AI judge, pattern write-ups and Ask Telemetry) ----
# API key for the LLM endpoint. Without one, the fixed rules still run on every action
# and the AI checks fall back to simple rules; only the chat needs the key.
ANTHROPIC_API_KEY=
# URL of the endpoint. Leave blank for https://api.anthropic.com, or set it to your
# internal gateway (it must serve the Anthropic Messages API).
ANTHROPIC_BASE_URL=
# Model and default reasoning effort (low, medium, high, xhigh, max).
TT_MODEL=claude-opus-5-5
TT_EFFORT=medium
# Server-side refusal fallback (beta). Set to false if your gateway rejects beta parameters.
TT_REFUSAL_FALLBACK=true

# ---- Telemetry source ----
# file:     an OTLP/JSON export, e.g. from the OpenTelemetry Collector's file exporter
# langfuse: the Langfuse public API
TT_SOURCE=file
TT_OTLP_FILE=data/sample_telemetry.json
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Other ----
# Status is judged on the last TT_WINDOW_DAYS; patterns compare it with TT_BASELINE_DAYS.
TT_WINDOW_DAYS=7
TT_BASELINE_DAYS=28
TT_PORT=8000
